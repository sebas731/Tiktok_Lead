// DEBE APARECER SIN GUIONES BAJOS EN EL THOR

enum SaleChannel {
  BASE_DE_DATOS
  RRSS_THOR
  RECUPEROS
  FACEBOOK
  TIKTOK
  INSTAGRAM
  GOOGLE
}

enum Operator {
  MOVISTAR
  CLARO
  ENTEL
  BITEL

}

enum Gender {
  MASCULINO
  FEMENINO
  NO_ESPECIFICO
}

enum ProductPlay {
  ONE_PLAY @map("1 PLAY")
  TWO_PLAY @map("2 PLAY")
  THREE_PLAY @map("3 PLAY")
