// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ALLOWED IPS
// ============================================================

enum IPType {
  COMPANY
  PERSONAL
}

model AllowedIP {
  id          String   @id @default(uuid())
  ip          String
  description String?
  type        IPType   @default(PERSONAL)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [user_id])
  userId String?

  @@unique([ip, userId]) // misma IP puede estar para varios usuarios
}

// ============================================================
// ROL
// ============================================================

model ROL {
  id_rol      String   @id @default(uuid())
  name        String   @unique
  description String
  create_at   DateTime @default(now())
  users       User[]
}

// ============================================================
// DOCUMENT TYPE
// ============================================================

enum DocumentType {
  DNI
  CE
  PASSAPORTE
  RUC
}

// ============================================================
// AUTH
// ============================================================

model User {
  user_id          String       @id @default(uuid())
  login            String       @unique
  password         String
  email            String       @unique
  name             String
  first_last_name  String
  second_last_name String
  department       String       @default("LIMA")
  document_type    DocumentType @default(DNI)
  document_number  String       @unique
  status           Boolean      @default(true)
  create_at        DateTime     @default(now())
  //FK
  rol              ROL          @relation(fields: [idRol], references: [id_rol])
  idRol            String
  ip_allowed       AllowedIP[]

  // asignaciones (campañas y leads)
  campaignAssignments    CampaignAssignment[]
  leadsAsignados         Lead[]               @relation("LeadAsesor")
  asignacionesComoAsesor LeadAssignment[]     @relation("AsignacionAsesor")
  asignacionesRealizadas LeadAssignment[]     @relation("AsignacionPor")
  leadsProcesados        LeadProcessLog[]     @relation("LeadProcesadoPor")

  // sedes, grupos y ventas
  sedeAccess           SedeAccess[]
  gruposComoSupervisor Grupo[]       @relation("GrupoSupervisor")
  membresiasGrupo      GrupoMember[] @relation("GrupoAsesor")
  salesAsAdvisor       Sale[]        @relation("SaleAdvisor")
  salesAsManager       Sale[]        @relation("SaleManager")
  salesAsBack          Sale[]        @relation("SaleBack")
}

// ============================================================
// K31S
// ============================================================
model Key {
  id           String    @id @default(uuid())
  name         String
  accessToken  String
  advertiserId String
  expiresAt    DateTime?
  status       Boolean   @default(true)

  campaigns Campaign[]
}

// ============================================================
// CAMPAIGN
// ============================================================

enum CampaignSource {
  TIKTOK
  EXCEL
}

// Modo de lectura de una hoja de Google Sheets.
enum SheetAccessMode {
  PUBLIC_CSV // hoja compartida públicamente, se lee el CSV export
  SERVICE_ACCOUNT // hoja privada, se lee vía Google Sheets API
}

// Resultado de la última sincronización de una campaña Excel.
enum SyncStatus {
  OK
  ERROR
}

// Modo de asignación de leads de una campaña.
enum LeadMode {
  NORMAL // el supervisor/admin asigna los leads a los asesores
  AUTO // los asesores ven todos los leads de la campaña y los atienden ellos mismos
}

model Campaign {
  campaign_id String @id @default(uuid())

  // origen de la campaña; el usuario elige al crearla
  source CampaignSource @default(TIKTOK)

  // datos de la API de tiktok (obligatorios solo si source = TIKTOK, validado en el servicio)
  tiktokCampaignId   String? @unique
  tiktokAdvertiserId String?

  // datos del origen Excel (obligatorios solo si source = EXCEL, validado en el servicio)
  // Modelo: una PESTAÑA = una campaña. Se lee la pestaña completa (sin filtrar por columna).
  excelUrl        String? // link del Google Sheet
  excelGid        String? // gid de la pestaña (fuente de verdad, estable ante renombrados)
  excelSheetName  String? // nombre actual de la pestaña (se refresca en cada sync)
  sheetAccessMode SheetAccessMode @default(PUBLIC_CSV)

  //datos de la campaña
  name         String
  denomination String?
  status       Boolean  @default(true)
  leadMode     LeadMode @default(NORMAL) // NORMAL: asignación manual · AUTO: autoservicio del asesor
  autoSync     Boolean  @default(true) // si la sincronización programada la incluye (solo EXCEL)
  // Si es true, el autoservicio (modo AUTO) también entrega leads NO_CONTACTO
  // ignorando el enfriamiento de 5h. Lo habilita admin/supervisor por campaña.
  allowNoContactoPull Boolean @default(false)

  // Reenvío al Thor de Jesús. thorMode: OFF (no envía) | ESTRICTO (NO crea leads,
  // solo envía a Thor) | PARALELO (crea leads Y envía a Thor). thorSlug = campaña
  // destino en el Thor (arma la URL .../{thorSlug}/ads). Lo activa un botón.
  thorMode String  @default("OFF")
  thorSlug String?

  // metricas para el dhasboard
  impressions Int   @default(0)
  clicks      Int   @default(0)
  spend       Float @default(0)
  leads       Int   @default(0)

  //datos para ejecutar la actualizacion de leads
  lastSyncAt      DateTime?
  lastSyncStatus  SyncStatus?
  lastSyncError   String? // motivo del último fallo de sincronización (visible en la UI)
  lastSyncSummary Json? // resumen de la última sync: leídas, nuevas, existentes, descartadas, errores
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // relations (key opcional: solo campañas TikTok)
  key   Key?    @relation(fields: [keyId], references: [id])
  keyId String?

  lead Lead[]

  // usuarios asignados (supervisores y back)
  campaignAssignments CampaignAssignment[]

  sales Sale[]
}

// ============================================================
// LEAD Y TIPOS DEL ENUM
// ============================================================

enum LEAD_STATUS {
  NEGATIVO
  POSITIVO
  AGENDADO
  NO_CONTACTO
  SIN_GESTION
}

enum LEAD_SUBSTATUS {
  OTRO
  //positivo
  VENTA
  //negativo
  YA_TIENE_CLARO
  NO_CALIFICA_POR_DNI
  CLIENTE_NO_SOLICITO_INFORMACION
  NO_TIENE_COBERTURA
  //agendado
  LO_PENSARA
  LLAMAR_MAS_TARDE
  //no contacto
  CELULAR_APAGADO
  NO_CONTESTA
}

model Lead {
  id            String         @id @default(uuid())
  name_client   String?
  client_number String
  status        LEAD_STATUS    @default(SIN_GESTION)
  sub_status    LEAD_SUBSTATUS @default(OTRO)
  observations  String?
  reason        String

  // id nativo de TikTok (los leads de Excel no lo tienen) — para sync idempotente
  tiktokLeadId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign   Campaign @relation(fields: [campaignId], references: [campaign_id])
  campaignId String

  // asesor asignado (estado actual)
  asignadoA   User?   @relation("LeadAsesor", fields: [asignadoAId], references: [user_id])
  asignadoAId String?

  // Control anti-bucle: AGENDADO reserva el lead 24h para su asesor; NO_CONTACTO
  // enfría el lead 5h antes de poder reasignarse. Vencido, vuelve al pool.
  reservedUntil DateTime?

  // historial de asignaciones, procesos y la venta cerrada
  assignments LeadAssignment[]
  processLogs LeadProcessLog[]
  sale        Sale?

  @@unique([client_number, campaignId])
  @@index([status])
  @@index([campaignId])
  @@index([asignadoAId])
  // Índices compuestos para las consultas frecuentes (pool, bandeja, listados).
  @@index([campaignId, asignadoAId, status])
  @@index([campaignId, createdAt])
}

// ============================================================
// CAMPAIGN ASSIGNMENT (m2m User <-> Campaign, supervisores y back)
// ============================================================

model CampaignAssignment {
  id         String   @id @default(uuid())
  campaign   Campaign @relation(fields: [campaignId], references: [campaign_id])
  campaignId String
  user       User     @relation(fields: [userId], references: [user_id])
  userId     String
  assignedAt DateTime @default(now())

  @@unique([campaignId, userId])
  @@index([userId])
  @@index([campaignId])
}

// ============================================================
// LEAD ASSIGNMENT (historial de asignaciones de leads a asesores)
// ============================================================

model LeadAssignment {
  id            String   @id @default(uuid())
  lead          Lead     @relation(fields: [leadId], references: [id])
  leadId        String
  asesor        User     @relation("AsignacionAsesor", fields: [asesorId], references: [user_id])
  asesorId      String
  asignadoPor   User     @relation("AsignacionPor", fields: [asignadoPorId], references: [user_id])
  asignadoPorId String
  createdAt     DateTime @default(now())

  @@index([leadId])
  @@index([asesorId])
}

// ============================================================
// LEAD PROCESS LOG (rastro de quién procesó cada lead y en qué estado lo dejó)
// ============================================================

model LeadProcessLog {
  id           String         @id @default(uuid())
  lead         Lead           @relation(fields: [leadId], references: [id])
  leadId       String
  user         User           @relation("LeadProcesadoPor", fields: [userId], references: [user_id])
  userId       String
  status       LEAD_STATUS
  sub_status   LEAD_SUBSTATUS
  observations String?
  processedAt  DateTime       @default(now())

  @@index([leadId])
  @@index([userId])
}

// ============================================================
// SEDES
// ============================================================

model Sede {
  sede_id   String   @id @default(uuid())
  code      String   @unique // código corto, ej. "LIM01", "SIS02"
  name      String
  address   String?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())

  access SedeAccess[]
  sales  Sale[]
  grupos Grupo[]
}

model SedeAccess {
  id        String    @id @default(uuid())
  sede      Sede      @relation(fields: [sedeId], references: [sede_id])
  sedeId    String
  user      User      @relation(fields: [userId], references: [user_id])
  userId    String
  grantedAt DateTime  @default(now())
  expiresAt DateTime? // null = acceso permanente
  active    Boolean   @default(true)

  @@unique([sedeId, userId])
  @@index([userId])
}

// ============================================================
// GRUPOS (jerarquía supervisor → asesores)
// ============================================================

model Grupo {
  grupo_id     String   @id @default(uuid())
  name         String
  supervisor   User     @relation("GrupoSupervisor", fields: [supervisorId], references: [user_id])
  supervisorId String
  // Un grupo (sala) pertenece a UNA sola sede.
  sede         Sede     @relation(fields: [sedeId], references: [sede_id])
  sedeId       String
  status       Boolean  @default(true)
  createdAt    DateTime @default(now())

  members GrupoMember[]

  @@index([supervisorId])
  @@index([sedeId])
}

model GrupoMember {
  id       String   @id @default(uuid())
  grupo    Grupo    @relation(fields: [grupoId], references: [grupo_id])
  grupoId  String
  asesor   User     @relation("GrupoAsesor", fields: [asesorId], references: [user_id])
  asesorId String
  joinedAt DateTime @default(now())

  @@unique([grupoId, asesorId])
  @@index([asesorId])
}

// ============================================================
// VENTA — estructura de 4 tablas (Client, Sale, SaleDetail, InstallationSchedule)
// ============================================================

model Client {
  id_cliente        String       @id @default(uuid())
  document_type     DocumentType @default(DNI)
  document_number   String
  titular_name      String
  last_names        String
  contacto_name     String? // contacto (nombres y apellidos)
  parentesco        String?
  fathers_name      String?
  number_calls      String? // teléfono para el técnico
  number_whatsapp   String? // para cobranzas
  operator_client   Operator @default(CLARO) // operadora del celular principal
  birth_date        DateTime?
  birth_place       String?
  gender            Gender @default(NO_ESPECIFICO)
  department        String? //DEPARTAMENTOS
  province          String? //PROVINCIAS
  district          String? //DISTRITOS
  address           String?
  reference_address String?
  nodo              String?
  email             String?
  ubigeo            String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  sales Sale[]
}

model Sale {
  id_sale String @id @default(uuid())
  code    String @unique // código de venta, ej. VNT-20260626...

  // Relaciones
  client           Client   @relation(fields: [clientId], references: [id_cliente])
  clientId         String
  campaign         Campaign @relation(fields: [campaingId], references: [campaign_id])
  campaingId       String
  lead             Lead?    @relation(fields: [leadId], references: [id])
  leadId           String?  @unique
  advisor          User     @relation("SaleAdvisor", fields: [advisorId], references: [user_id])
  advisorId        String
  managerAdvisor   User?    @relation("SaleManager", fields: [managerAdvisorId], references: [user_id])
  managerAdvisorId String?
  backOffice       User?    @relation("SaleBack", fields: [backOfficeId], references: [user_id])
  backOfficeId     String?
  sede             Sede     @relation(fields: [sedeId], references: [sede_id])
  sedeId           String

  sale_date DateTime @default(now())

  // Estado de venta (motivo + submotivo) y que puede editar el back
  reason     SaleStatus     @default(INGRESADA)
  sub_reason SaleSubStatus?

  // Campos que llena el ASESOR
  sale_channel   SaleChannel @default(TIKTOK)
  number_record String? //N° de grabacion
  product_play   ProductPlay @default(THREE_PLAY)
  product        Product @default(HFC_PURO)
  network_plan   NetworkPlan @default(MB_150)
  tv_plan        TvPlan @default(CLARO_HD_TV_BASICO)
  phone_plan     PlainPhone @default(MINUTOS_1000)
  type_sale      TypeSale @default(ALTA_NUEVA)
  pack_price     Float?
  repeater       Repetidor @default(MESH_1)
  deco1          OpcionDeco1 @default(DECO_BASICO_HD_1)
  deco2          OpcionDeco2 @default(DECO_BASICO_SD_1)
  premium_pack   PremiunPacks
  total_price    Float?
  observations   String?  
  equifax_document    String? // ruta o url del archivo
  record_validation   RecordValidation
  full_claro          FullClaro
  region  Region @default(CENTRO)
  client_pay ClientPay //CLIENTE DE PAGO
  operation_type OperationType //tipo de operacion
  address_type   BuildType //TIPO DE DOMICILIO
  high_value     HighValue
  consolidado         Int?

  // Campos que llena el BACK
  sec                 String?
  sot                 String?
  ugis                String?
  contrata_inst       String?
  codigo_cliente_pago String?

  sale_details SaleDetail?
  installation InstallationSchedule?

 //campos automaticos
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaingId])
  @@index([advisorId])
  @@index([sedeId])
  @@index([reason])
}

// Seguimiento posterior, lo llena BACK
model SaleDetail {
  id_sale_detail String @id @default(uuid())
  sale           Sale   @relation(fields: [saleId], references: [id_sale])
  saleId         String @unique
  cod_client        String?
  //payment_date      DateTime?
  //payment_status    String?
  pdv               Pdv
  rejection_date    DateTime?
  contrata_ins      String?
  installation_date DateTime?
  loteado           Loteado
  equifax           Equifax 
  created_at DateTime @default(now())
  update_at  DateTime @updatedAt
}
enum Pdv {
  PDV_LIMA
  PDV_NORTE
}
enum Equifax {
  PENDIENTE_DE_VALIDAR @map("PENDIENTE DE VALIDAR")
  APROBADO @map("APROBADO")
  DESAPROBADO @map("DESAPROBADO")
  NO_PROCEDE @map("NO PROCEDE")
}

enum Loteado {
  NO @map("NO")
  SI @map("SI")
  VOLVER_A_GRABAR @map("VOLVER A GRABAR")
  NO_HAY_GRABACION @map("NO HAY GRABACION")
  ENVIADO_SUBSANADO @map("ENVIADO-SUBSANADO")
  PENDIENTE_DE_LOTEAR @map("PENDIENTE DE LOTEAR")
  FALTA_GRAVE_DE_CALIDAD @map("FALTA GRAVE DE CALIDAD")

}

model InstallationSchedule {
  sale              Sale      @relation(fields: [saleId], references: [id_sale])
  saleId            String    @id
  installation_date DateTime?
  installation_time String? //salir el rango en el front end ocn un cboBox 2:00 a 6:00 pm / 9:00 a 1:00 pm
  coments           String?
}



